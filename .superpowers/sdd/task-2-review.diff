+# PowerShell Modules
+
+Reusable PowerShell modules for SQL Server administration scripts.
+
+## 📝 [sql](./sql.psm1)
+
+Module providing `Invoke-SqlQuery` helper using `Microsoft.Data.SqlClient` (with fallback to `System.Data.SqlClient`) for robust database querying.
+
+## 📝 [smtp](./smtp.ps1)
+
+Function for sending HTML emails using System.Net.Mail. Used by health check and reporting scripts.
+
+## 📝 [stylesheet](./stylesheet.ps1)
+
+HTML stylesheet definition for formatting reports generated by the daily-check and other reporting scripts.
+
diff --git a/powershell/daily-check/modules/smtp.ps1 b/powershell/daily-check/modules/smtp.ps1
new file mode 100644
index 0000000..d146627
--- /dev/null
+++ b/powershell/daily-check/modules/smtp.ps1
@@ -0,0 +1,23 @@
+function Send-DailyCheckReport ($emailFrom, $emailTo, $subject, $body, $smtpServer, $smtpPort = 25) {
+    $mail = $null
+    $smtp = $null
+    try {
+        $mail = New-Object System.Net.Mail.MailMessage
+        $mail.From = $emailFrom
+        foreach ($to in $emailTo) { $mail.To.Add($to) }
+        $mail.Subject = $subject
+        $mail.Body = $body
+        $mail.IsBodyHtml = $true
+        $mail.BodyEncoding = [System.Text.Encoding]::UTF8
+        $mail.SubjectEncoding = [System.Text.Encoding]::UTF8
+        
+        $smtp = New-Object System.Net.Mail.SmtpClient($smtpServer, $smtpPort)
+        $smtp.Send($mail)
+    } catch {
+        $Host.UI.WriteErrorLine("Failed to send email: $_")
+        exit 2
+    } finally {
+        if ($null -ne $mail) { $mail.Dispose() }
+        if ($null -ne $smtp) { $smtp.Dispose() }
+    }
+}
\ No newline at end of file
